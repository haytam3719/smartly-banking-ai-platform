{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartly.example/contracts/events/ai.agent.call.started.v1.schema.json",
  "title": "ai.agent.call.started.v1",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    { "required": ["conversation_id"], "properties": {
      "event_type": { "const": "ai.agent.call.started.v1" },
      "payload": { "type": "object", "additionalProperties": false, "required": ["agent_id", "capability", "agent_request_id"], "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "capability": { "$ref": "../schemas/capability.schema.json" },
        "agent_request_id": { "type": "string", "minLength": 1 }
      } }
    } }
  ]
}
