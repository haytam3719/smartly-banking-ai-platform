{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartly.example/contracts/events/ai.response.generated.v1.schema.json",
  "title": "ai.response.generated.v1",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    { "required": ["conversation_id"], "properties": {
      "event_type": { "const": "ai.response.generated.v1" },
      "payload": { "type": "object", "additionalProperties": false, "required": ["response_id", "capabilities_used", "evidence_count", "model_id", "latency_ms"], "properties": {
        "response_id": { "type": "string", "minLength": 1 },
        "capabilities_used": { "type": "array", "uniqueItems": true, "items": { "$ref": "../schemas/capability.schema.json" } },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "model_id": { "type": "string", "minLength": 1 },
        "latency_ms": { "type": "integer", "minimum": 0 }
      } }
    } }
  ]
}
